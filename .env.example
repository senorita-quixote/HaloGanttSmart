VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_LINEAR_CLIENT_ID=your-linear-oauth-client-id
VITE_LINEAR_REDIRECT_URI=http://localhost:5173/callback

# Optional: standard (default) or keycloak. Rebuild after changing this value.
VITE_AUTH_MODE=standard

# Optional: local mode. Set a Linear personal API key (Linear > Settings > Security & access)
# to skip Supabase sign-in and the Linear OAuth app when running `npm run dev`.
# Ignored by production builds. Share links and Plan vs Actual are unavailable in this mode.
# VITE_LINEAR_API_KEY=lin_api_...
